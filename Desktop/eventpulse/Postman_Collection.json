            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/registrations/events/{{eventId}}/register",
          "host": [
            "{{baseUrl}}"
          ],
