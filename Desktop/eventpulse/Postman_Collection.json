      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@eventpulse.com\", \"password\": \"Admin@123456\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
